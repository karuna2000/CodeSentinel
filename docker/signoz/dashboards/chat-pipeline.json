{
  "tags": [
    {
      "key": "domain",
      "value": "codesintler"
    }
  ],
  "spec": {
    "display": {
      "name": "CodeSentinel \u2014 Chat Pipeline",
      "description": "Request rate, stage latency, and guardrail blocks for the grounded Q&A pipeline. Import via SigNoz UI (Dashboards \u2192 Import JSON)."
    },
    "variables": [],
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Overview",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/chat-answer-rate"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/chat-stage-latency"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/guardrail-blocks"
              }
            }
          ]
        }
      }
    ],
    "panels": {
      "chat-answer-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Chat answers by status"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "filter": {
                            "expression": "name = 'chat.answer'"
                          },
                          "groupBy": [
                            {
                              "name": "status.string"
                            }
                          ],
                          "having": {
                            "expression": ""
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "chat-stage-latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Stage latency p95 (classify/retrieve/generate/gates/judge)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom"
              },
              "formatting": {
                "unit": "ms"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "aggregations": [
                            {
                              "expression": "p95(durationNano)/1000000"
                            }
                          ],
                          "filter": {
                            "expression": "name IN ('chat.classify','chat.retrieve','chat.generate','chat.gates','chat.judge')"
                          },
                          "groupBy": [
                            {
                              "name": "name"
                            }
                          ],
                          "having": {
                            "expression": ""
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "guardrail-blocks": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Guardrail blocks (failed gates)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "traces",
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "filter": {
                            "expression": "name = 'chat.gates'"
                          },
                          "groupBy": [],
                          "having": {
                            "expression": ""
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}