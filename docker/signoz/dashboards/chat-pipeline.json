{
  "title": "CodeSentinel — Chat Pipeline",
  "description": "Request rate, latency, and cache behavior for the grounded Q&A pipeline. Import via SigNoz UI (Dashboards → Import JSON) or POST /api/v1/dashboards.",
  "widgets": [
    {
      "title": "Chat answer rate by status",
      "description": "Count of chat.answer spans grouped by status",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "aggregateOperator": "count",
              "aggregateAttribute": { "key": "", "type": "" },
              "filters": {
                "op": "AND",
                "items": [
                  { "key": { "key": "name", "type": "tag" }, "op": "=", "value": "chat.answer" }
                ]
              },
              "groupBy": [{ "key": "status.string", "type": "tag" }]
            }
          ]
        }
      }
    },
    {
      "title": "Stage latency p95 (classify/retrieve/generate/gates)",
      "description": "p95 duration of pipeline stage spans",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "aggregateOperator": "p95",
              "aggregateAttribute": { "key": "durationNano", "type": "" },
              "filters": {
                "op": "AND",
                "items": [
                  { "key": { "key": "name", "type": "tag" }, "op": "IN", "value": ["chat.classify", "chat.retrieve", "chat.generate", "chat.gates", "chat.judge"] }
                ]
              },
              "groupBy": [{ "key": "name", "type": "tag" }]
            }
          ]
        }
      }
    },
    {
      "title": "Guardrail blocks by gate",
      "description": "Count of chat.gates spans where a gate failed (blocked answers)",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "aggregateOperator": "count",
              "aggregateAttribute": { "key": "", "type": "" },
              "filters": {
                "op": "AND",
                "items": [
                  { "key": { "key": "name", "type": "tag" }, "op": "=", "value": "chat.gates" }
                ]
              },
              "groupBy": []
            }
          ]
        }
      }
    }
  ]
}
