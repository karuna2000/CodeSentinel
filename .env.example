# ─── GitHub OAuth (sign-in identity via NextAuth) ───────────────────────────────
# Create at: https://github.com/settings/developers (OAuth Apps)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# GitHub App (for Repository Access)
# Create at: https://github.com/settings/apps/new
GITHUB_APP_ID="your-github-app-id"
GITHUB_APP_PRIVATE_KEY="your-github-app-private-key-with-newlines-replaced-by-\n"
GITHUB_WEBHOOK_SECRET="your-custom-webhook-secret"

# ─── NextAuth ───────────────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"

# Public base URL of the application
NEXTAUTH_URL=http://localhost:3000

# ─── NVIDIA LLM API ─────────────────────────────────────────────────────────────
# Obtain from: https://integrate.api.nvidia.com
NVIDIA_API_KEY="your-nvidia-api-key"

# ─── Local Postgres (Docker Compose) ──────────────────────────────────────────
# Start it with: docker compose up -d db
# Fixed port 5433 (avoids clashing with host-native Postgres on 5432).
# Dev-only default password lives in docker-compose.yml; override with
# POSTGRES_PASSWORD in your shell for anything beyond local dev.
DATABASE_URL="postgresql://postgres:codesentinel-dev@localhost:5433/postgres?schema=public"

# ─── Anonymous demo (optional) ──────────────────────────────────────────────────
# Comma-separated repository ids served without sign-in at /demo.
# Only these ids are ever readable anonymously; empty disables the demo.
DEMO_REPO_IDS=""

# ─── Tracing export (optional) ────────────────────────────────────────────────
# OTLP endpoint for OpenTelemetry spans (chat.classify/retrieve/generate/gates).
# When unset and Langfuse keys are present, spans go to Langfuse OTLP ingestion;
# otherwise spans are dropped (local dev stays quiet).
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Resource identity attached to every span/metric/log (SigNoz service views).
OTEL_SERVICE_NAME="codesentinel-api"
APP_ENV="development"
# Deploy-aware version for regression correlation (set to the git SHA in CI).
SERVICE_VERSION="dev"

# ─── Telemetry content capture (optional, dev-only) ───────────────────────────
# When 'true', raw content fields (prompts, answers, queries) may be included
# in telemetry. Default false: identifiers and counts only. Never enable in
# production — repository source plus secrets must not leave the process.
OBS_CAPTURE_CONTENT=""

# ─── Local Redis (optional — chat answer cache) ─────────────────────────────────
# RESP-protocol Redis for the chat answer cache (Phase C). Any stock Redis works:
# run `docker run -d -p 6379:6379 redis:8-alpine`. When unset, caching is
# disabled and every question is a cache miss (correct, just full price).
# NOTE: this is separate from rate limiting, which uses @upstash/redis (REST)
# and is configured via UPSTASH_REDIS_REST_URL/TOKEN above.
REDIS_URL=""

# ─── Upstash Redis (optional — global rate limiting) ───────────────────────────
# Required only for multi-instance / production rate limiting. When unset, the app
# uses a per-instance in-memory store (fine for single-process dev).
# Create free at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Background Jobs (optional) ───────────────────────────────────────────────
# Guards POST /api/jobs/run, the cron endpoint that drains the generation queue.
# Required for serverless deploys where no long-lived worker process exists —
# point a cron at it with header: x-jobs-secret: <value>. In local dev it may be
# left empty (endpoint is then restricted to development only).
JOBS_RUN_SECRET=""

# Optional. Max LLM tokens a user may consume per day (input + output),
# across code review, chat and intent detection. Leave empty to disable the cap.
LLM_BUDGET_DAILY_TOKENS=""
